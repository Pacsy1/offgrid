# Optional: Offgrid Connect source builds
# `cp .env.example .env` sets the Clerk identifiers. Offgrid Connect also needs
# OFFGRID_RELAY_URL, which a self-hosted relay deploy writes. These are public
# identifiers, not secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
OFFGRID_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
OFFGRID_CLERK_JWT_TEMPLATE=offgrid-relay
OFFGRID_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in OFFGRID_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# OFFGRID_APPLE_TEAM_ID=ABC1234567
# OFFGRID_MACOS_PROVISIONING_PROFILE=/absolute/path/to/offgrid.provisionprofile
# OFFGRID_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Offgrid Connect needs a relay. None is set here: deploy your own from `infra/relay`,
# which writes OFFGRID_RELAY_URL into `.env`.

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.t3.codes; override to test against a staging deployment.
# OFFGRID_HOSTED_APP_URL=https://nightly.app.t3.codes

