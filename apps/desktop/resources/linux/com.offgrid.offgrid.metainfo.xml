<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.offgrid.offgrid</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Offgrid</name>
  <summary>Desktop GUI for coding agents</summary>
  <developer id="com.offgrid">
    <name>Offgrid contributors</name>
  </developer>
  <description>
    <p>
      Offgrid is a telemetry-free, open-source desktop app for coding agents. Work with your
      existing agent subscriptions, review code changes, and run commands in
      your projects.
    </p>
    <p>
      Connect from desktop, web, or mobile to continue working remotely.
    </p>
  </description>
  <launchable type="desktop-id">offgrid.desktop</launchable>
  <icon type="stock">offgrid</icon>
  <provides>
    <binary>offgrid</binary>
  </provides>
  <categories>
    <category>Development</category>
  </categories>
  <url type="homepage">https://github.com/Pacsy1/offgrid</url>
  <url type="bugtracker">https://github.com/Pacsy1/offgrid/issues</url>
  <url type="vcs-browser">https://github.com/Pacsy1/offgrid</url>
</component>
